QWEN38_FP8_MODEL=Qwen/Qwen3.8-27B-FP8
QWEN38_FP8_SERVED_MODEL_NAME=qwen3.8-27b-fp8
QWEN38_FP8_CONTAINER_NAME=vllm-qwen38-27b-fp8-candidate

# Benchmark-only: EXAONE AI Model License Agreement 1.2 - NC.
EXAONE45_AWQ_MODEL=LGAI-EXAONE/EXAONE-4.5-33B-AWQ
EXAONE45_AWQ_SERVED_MODEL_NAME=exaone-4.5-33b-awq
