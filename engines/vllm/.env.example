# Required: host path that contains Hugging Face model/cache files.
HF_CACHE=/path/to/huggingface-cache

# Optional: set when gated models require authentication.
# HF_TOKEN=

# Qwen3.6 35B-A3B NVFP4 MTP-off baseline defaults for DGX Spark.
QWEN36_NVFP4_VLLM_IMAGE=vllm/vllm-openai:v0.24.0-ubuntu2404
QWEN36_NVFP4_CONTAINER_NAME=vllm-qwen36-35b-a3b-nvfp4-baseline
QWEN36_NVFP4_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
QWEN36_NVFP4_SERVED_MODEL_NAME=qwen3.6-35b-a3b-nvfp4
QWEN36_NVFP4_PORT=8000
QWEN36_NVFP4_MAX_MODEL_LEN=32768
QWEN36_NVFP4_MAX_NUM_SEQS=2
QWEN36_NVFP4_MAX_NUM_BATCHED_TOKENS=8192
QWEN36_NVFP4_GPU_MEMORY_UTILIZATION=0.40
QWEN36_NVFP4_TOOL_CALL_PARSER=qwen3_xml

# Qwen3.6 NVFP4 NVIDIA-recommended MTP n3 A/B profile.
QWEN36_NVFP4_MTP_CONTAINER_NAME=vllm-qwen36-35b-a3b-nvfp4-mtp
QWEN36_NVFP4_MTP_PORT=8000

# Common DGX Spark candidate characterization defaults.
CANDIDATE_VLLM_IMAGE=vllm/vllm-openai:v0.27.1-ubuntu2404
CANDIDATE_PORT=8000
CANDIDATE_MAX_MODEL_LEN=32768
CANDIDATE_MAX_NUM_SEQS=2
CANDIDATE_MAX_NUM_BATCHED_TOKENS=8192
CANDIDATE_GPU_MEMORY_UTILIZATION=0.40

GEMMA4_NVFP4_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
GEMMA4_NVFP4_REVISION=a19cfe00be84568a6867111c9a68c9c44fdcffe6
GEMMA4_NVFP4_SERVED_MODEL_NAME=gemma-4-26b-a4b-nvfp4
GEMMA4_NVFP4_CONTAINER_NAME=vllm-gemma4-26b-a4b-nvfp4-candidate
GEMMA4_NVFP4_VLLM_IMAGE=vllm/vllm-openai@sha256:3dbe092ec5b2cef63b6104d33fa75d6ce53a7870962529ada69f78bbbc38e776
GEMMA4_NVFP4_HOST=127.0.0.1
GEMMA4_NVFP4_PORT=8000
