{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openai-compatible-quick-result-v1.json",
  "title": "OpenAI-compatible quick benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "completed_at",
    "elapsed_s",
    "benchmark",
    "base_url",
    "model",
    "classification",
    "metadata_status",
    "metadata",
    "request_settings",
    "checks",
    "performance",
    "resource_snapshot",
    "passed",
    "failures"
  ],
  "properties": {
    "schema_version": {"const": "openai-compatible-quick/v1"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "elapsed_s": {"type": "number", "minimum": 0},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation"],
      "properties": {
        "name": {"const": "openai-compatible-quick-check"},
        "version": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1}
      }
    },
    "base_url": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "classification": {"const": "quick"},
    "metadata_status": {"enum": ["provided", "not_provided"]},
    "metadata": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/metadata"}
      ]
    },
    "request_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup",
        "stream_runs",
        "concurrency",
        "concurrent_requests",
        "max_tokens",
        "tool_runs",
        "performance_prompt_profile",
        "reasoning_effort",
        "chat_template_kwargs"
      ],
      "properties": {
        "warmup": {"type": "integer", "minimum": 0},
        "stream_runs": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "concurrent_requests": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "tool_runs": {"type": "integer", "minimum": 0},
        "performance_prompt_profile": {"enum": ["repeated-word", "sequential-integers"]},
        "reasoning_effort": {"type": ["string", "null"]},
        "chat_template_kwargs": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/check_result"}
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming_single_user", "closed_loop"],
      "properties": {
        "streaming_single_user": {"type": "object"},
        "closed_loop": {"type": "object"}
      }
    },
    "resource_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "host_memory", "accelerators", "accelerator_processes", "errors"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "host_memory": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["total_bytes", "available_bytes"],
              "properties": {
                "total_bytes": {"type": ["integer", "null"], "minimum": 0},
                "available_bytes": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          ]
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "name", "driver_version", "utilization_pct", "temperature_c"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "name": {"type": "string", "minLength": 1},
              "driver_version": {"type": "string", "minLength": 1},
              "utilization_pct": {"type": ["number", "null"], "minimum": 0},
              "temperature_c": {"type": ["number", "null"]}
            }
          }
        },
        "accelerator_processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "process_name", "used_memory_mib"],
            "properties": {
              "pid": {"type": "integer", "minimum": 1},
              "process_name": {"type": "string", "minLength": 1},
              "used_memory_mib": {"type": ["number", "null"], "minimum": 0}
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "passed": {"type": "boolean"},
    "failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "check_result": {
      "type": "object",
      "required": ["passed"],
      "properties": {
        "passed": {"type": "boolean"},
        "elapsed_s": {"type": "number", "minimum": 0},
        "error_type": {"type": "string"},
        "error": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware",
        "model_artifact",
        "serving",
        "software",
        "execution",
        "provenance"
      ],
      "properties": {
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "accelerator", "accelerator_count", "memory_gib"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "accelerator": {"type": "string", "minLength": 1},
            "accelerator_count": {"type": "integer", "minimum": 1},
            "memory_gib": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "model_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "quantization", "tokenizer_revision"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "revision": {"$ref": "#/$defs/nullable_string"},
            "quantization": {"type": "string", "minLength": 1},
            "tokenizer_revision": {"$ref": "#/$defs/nullable_string"}
          }
        },
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version", "image", "image_digest", "command_profile", "options", "speculative"],
          "properties": {
            "engine": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "image": {"type": "string", "minLength": 1},
            "image_digest": {"$ref": "#/$defs/nullable_string"},
            "command_profile": {"type": "string", "minLength": 1},
            "options": {"type": "object"},
            "speculative": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "draft_model", "draft_revision", "settings"],
              "properties": {
                "mode": {"type": "string", "minLength": 1},
                "draft_model": {"$ref": "#/$defs/nullable_string"},
                "draft_revision": {"$ref": "#/$defs/nullable_string"},
                "settings": {"type": "object"}
              }
            }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "kernel", "driver", "container_runtime"],
          "properties": {
            "os": {"$ref": "#/$defs/nullable_string"},
            "kernel": {"$ref": "#/$defs/nullable_string"},
            "driver": {"$ref": "#/$defs/nullable_string"},
            "container_runtime": {"$ref": "#/$defs/nullable_string"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["benchmark_host", "network_path", "cpu_affinity"],
          "properties": {
            "benchmark_host": {"type": "string", "minLength": 1},
            "network_path": {"type": "string", "minLength": 1},
            "cpu_affinity": {"$ref": "#/$defs/nullable_string"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_revision", "worktree_dirty", "notes"],
          "properties": {
            "repository_revision": {"$ref": "#/$defs/nullable_string"},
            "worktree_dirty": {"type": "boolean"},
            "notes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
