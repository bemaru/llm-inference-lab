# Local WSL PoC defaults. Copy to .env only when overriding them.
MLFLOW_VERSION=3.13.0
PSYCOPG2_BINARY_VERSION=2.9.12
MLFLOW_HOST_PORT=15000
MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:5000,127.0.0.1:5000,localhost:15000,127.0.0.1:15000

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
# Use a URL-safe secret because it is interpolated into the PostgreSQL URI.
POSTGRES_PASSWORD=replace-with-a-url-safe-secret
